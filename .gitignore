# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# local file-based dev store (temporary, until real DB — see README)
/.data/

# typescript
*.tsbuildinfo
next-env.d.ts

# Capacitor native projects — generated build output, not source
android/app/build
android/.gradle
android/local.properties
# Release signing secrets — never commit. See README's Android release
# signing section for how to regenerate this on a new machine.
android/keystore.properties
ios/App/Pods
ios/App/build
ios/App/DerivedData
ios/.build
